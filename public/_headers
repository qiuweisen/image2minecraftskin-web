# Vite assets include content hashes, so they can be cached safely for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned simulator derivatives can be cached for a year. Other image URLs
# are assigned their shorter cache policy by the Worker response.
/images/simulators/*-480.webp
  Cache-Control: public, max-age=31536000, immutable

/images/simulators/*-600.webp
  Cache-Control: public, max-age=31536000, immutable

/images/simulators/*-768.webp
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/TradingView/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/badges/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/chartmini-favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
