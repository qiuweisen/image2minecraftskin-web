{
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/unit/skin-model.test.ts"],
  "exclude": [
    "dist",
    "src/api",
    "src/auth",
    "src/cache",
    "src/db",
    "src/locales",
    "src/mail",
    "src/middlewares",
    "src/newsletter",
    "src/notification",
    "src/payment",
    "src/storage",
    "src/store",
    "src/components/admin",
    "src/components/auth",
    "src/components/dashboard",
    "src/components/marketing",
    "src/components/payment",
    "src/components/pricing",
    "src/components/settings",
    "src/components/simulator",
    "tests/unit/analyze-api.test.ts",
    "tests/unit/seo-routing.test.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "content-collections": ["./.content-collections/generated"]
    }
  }
}
